# ==============================================================================
# Fakher Alam Used Cars Shipping - Environment Configuration Template
# ==============================================================================
# NOTICE: NEVER commit real credentials, service-role keys, or secret tokens.
# Frontend build consumes ONLY VITE_ prefixed public variables.
# ==============================================================================

# Public Supabase URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://placeholder-project.supabase.co

# Public Supabase Anon (Browser) Key - Safe for client exposure
VITE_SUPABASE_ANON_KEY=placeholder-anon-key-never-use-service-role-here

# Application Mode: "demo" or "production"
# In demo mode, mock calculation & lead data is used without requiring live backend connection
VITE_APP_MODE=demo

# Primary WhatsApp Business contact number (E.164 format without +, e.g. 971521234567)
VITE_WHATSAPP_NUMBER=971521234567

# Office Location details (Sharjah UAE)
VITE_COMPANY_PHONE=+971 52 123 4567
VITE_COMPANY_EMAIL=info@fakheralamshipping.com
VITE_COMPANY_ADDRESS="Industrial Area 2, Sharjah, UAE"
