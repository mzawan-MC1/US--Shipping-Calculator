# ==============================================================================
# Fakher Alam Used Cars Shipping - Environment Configuration Template
# ==============================================================================
# NOTICE: NEVER commit real credentials, service-role keys, or secret tokens.
# Frontend build consumes ONLY VITE_ prefixed public variables.
# ==============================================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key (Format: sb_publishable_... or legacy JWT anon key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy Anon Key fallback (optional if VITE_SUPABASE_PUBLISHABLE_KEY is provided)
VITE_SUPABASE_ANON_KEY=

# Application Runtime Mode: "production" or "demo"
# In production, valid Supabase configuration is strictly required (no silent fallback).
VITE_APP_MODE=production

# WhatsApp & Contact Channels
VITE_WHATSAPP_NUMBER=971521234567
VITE_COMPANY_PHONE=+971 52 123 4567
VITE_COMPANY_EMAIL=info@fakheralamshipping.com
VITE_COMPANY_ADDRESS="Industrial Area 2, Sharjah, UAE"